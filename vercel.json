{
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/reoptimize.js": {
      "maxDuration": 120
    },
    "api/generateschedule.js": {
      "maxDuration": 120
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/cache.js": {
      "maxDuration": 30
    },
    "api/cache-health.js": {
      "maxDuration": 15
    },
    "api/cron-cache.js": {
      "maxDuration": 300
    },
    "api/waittimes.js": {
      "maxDuration": 15
    },
    "api/blog-auth.js": {
      "maxDuration": 10
    },
    "api/blog-post.js": {
      "maxDuration": 10
    },
    "api/blog-index.js": {
      "maxDuration": 10
    },
    "api/blog-save.js": {
      "maxDuration": 15
    },
    "api/blog-delete.js": {
      "maxDuration": 10
    },
    "api/blog-migrate.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron-cache?key=park_intel",
      "schedule": "0 3 */10 * *"
    },
    {
      "path": "/api/cron-cache?key=dining_intel",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron-cache?key=events_intel",
      "schedule": "0 3 */7 * *"
    },
    {
      "path": "/api/cron-cache?key=park_hours_intel",
      "schedule": "0 3 */7 * *"
    },
    {
      "path": "/api/cron-cache?key=park_intel_dl_stable",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron-cache?key=park_intel_dl_dynamic",
      "schedule": "0 4 * * 1"
    }
  ]
}