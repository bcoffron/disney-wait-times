      "maxDuration": 60
    },
    "api/cron-cache.js": {
      "maxDuration": 300
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/waittimes.js": {
      "maxDuration": 15
    },
    "api/cache-health.js": {
      "maxDuration": 15
    }
  },
  "crons": [
